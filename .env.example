MONGODB_URI=
MONGODB_DB=damnart_crm

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

SEED_ADMIN_NAME=DamnArt CRM Administrator
SEED_ADMIN_EMAIL=admin@damnart.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

APP_URL=http://localhost:3000

# Set to true to overwrite the existing admin password from SEED_ADMIN_PASSWORD.
# RESET_ADMIN_PASSWORD=true

# Set to true in development only to create the demonstration website during seed.
ALLOW_DEMO_SEED=false

# Optional rate-limit overrides
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_BLOCK_MINUTES=15
# WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# WEBHOOK_RATE_LIMIT_PER_HOUR=300

# --- Vercel production ---
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-project.vercel.app
# APP_URL=https://your-project.vercel.app
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
